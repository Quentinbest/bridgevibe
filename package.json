{
  "name": "bridgevibe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:internal": "vite build --mode internal",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "deps:check": "depcruise --config .dependency-cruiser.cjs src",
    "licences:candidates": "node scripts/licences/candidates.ts",
    "f4:labels": "node scripts/f4/labels.ts",
    "f4:draft": "node scripts/f4/draft.ts",
    "robots:sample": "node scripts/robots/sample.ts",
    "content:check": "node scripts/content/check.ts",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run deps:check && npm run content:check && npm test && npm run test:browser && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "bridge-dds": "1.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
